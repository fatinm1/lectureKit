ANTHROPIC_API_KEY=your_key_here
CORS_ORIGINS=https://your-vercel-app.vercel.app
CHROMA_DB_PATH=/data/chroma_db
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: Netscape cookies.txt from a logged-in browser session — helps Railway/datacenter IPs access captions.
# Same file can be used by youtube-transcript-api and yt-dlp.
YTDLP_COOKIE_FILE=
YOUTUBE_COOKIES_PATH=

# Optional: HTTP proxy for youtube-transcript-api JSON: {"http":"http://host:port","https":"http://host:port"}
YOUTUBE_TRANSCRIPT_PROXIES=
