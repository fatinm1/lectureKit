ANTHROPIC_API_KEY=your_key_here
CORS_ORIGINS=https://your-vercel-app.vercel.app
CHROMA_DB_PATH=/data/chroma_db
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: Netscape cookies — path on disk (Railway: use a volume path e.g. /data/cookies.txt)
YTDLP_COOKIE_FILE=/data/cookies.txt
YOUTUBE_COOKIES_PATH=
# Optional: base64-encoded minimal cookies.txt (written to YTDLP_COOKIE_FILE at startup; no file upload)
YOUTUBE_COOKIES_BASE64=

# Optional: proxy URLs for transcript traffic — rotated until one succeeds (Webshare etc.).
YOUTUBE_PROXY_URL=
# Comma-separated or JSON array, appended after YOUTUBE_PROXY_URL
YOUTUBE_PROXY_URL_LIST=
YOUTUBE_PROXY_URL_1=
YOUTUBE_PROXY_URL_2=
YOUTUBE_PROXY_URL_3=
YOUTUBE_PROXY_URL_4=
YOUTUBE_PROXY_URL_5=
YOUTUBE_PROXY_URL_6=
YOUTUBE_PROXY_URL_7=
YOUTUBE_PROXY_URL_8=
YOUTUBE_PROXY_URL_9=
YOUTUBE_PROXY_URL_10=

# Optional: yt-dlp YouTube PO token / visitor data (see yt-dlp PO Token guide). YOUTUBE_PO_TOKEN often looks like web.gvs+...
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# Optional: HTTP proxy JSON {"http":"...","https":"..."} or one URL — used if YOUTUBE_PROXY_URL is unset
YOUTUBE_TRANSCRIPT_PROXIES=
