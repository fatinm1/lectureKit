{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "dev": "next dev",
    "dev:fresh": "npm run clean && next dev",
    "dev:turbo": "npm run clean && next dev --turbo",
    "dev:stable": "npm run clean && npm run build && next start -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:smoke": "node ./scripts/smoke-browser.mjs"
  },
  "engines": {
    "node": ">=18 <=22"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
